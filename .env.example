# ── 필수 ─────────────────────────────────────────────────────────
# Postgres 연결 문자열. 로컬 Postgres 와 Supabase 가 같은 코드로 동작한다.
#  · 로컬:    postgresql://postgres@localhost:5432/calling_desk
#  · Supabase: Project Settings > Database > Connection string > URI
#    Vercel 배포 시에는 포트 6543 의 Connection pooling URI 를 쓸 것
#    (서버리스에서 직결을 쓰면 커넥션이 금방 고갈된다)
DATABASE_URL=

# 이 도구에 들어오기 위한 시크릿. Auth 없이 이것 하나로 막는다.
# 충분히 긴 임의 문자열로 바꿀 것:  openssl rand -base64 32
APP_SECRET=

# ── 선택 ─────────────────────────────────────────────────────────
# 조각 추출 / 문장 다듬기에 사용. 없으면 그 두 기능만 비활성화되고
# 규칙 기반 기능(완성도 점검·코칭 질문·증빙 관리)은 전부 동작한다.
ANTHROPIC_API_KEY=

# 업로드 파일 보관 위치. local = ./.data/uploads, supabase = Storage 버킷
STORAGE_DRIVER=local

# STORAGE_DRIVER=supabase 일 때만 필요
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=calling-desk
